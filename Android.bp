soong_namespace {
    imports: [
        "hardware/google/interfaces",
        "hardware/google/pixel/pixelstats",
        "hardware/google/pixel/power-libperfmgr",
        "hardware/lineage/interfaces/power-libperfmgr",
        "hardware/qcom-caf/common/libqti-perfd-client",
        "hardware/xiaomi",
        "vendor/qcom/opensource/commonsys-intf/display",
    ],
}

install_symlink {
    name: "firmware_wlan_mac.bin_symlink",
    vendor: true,
    installed_location: "firmware/wlan/qca_cld/adrastea/wlan_mac.bin",
    symlink_target: "/mnt/vendor/persist/wlan/wlan_mac.bin",
}

install_symlink {
    name: "firmware_WCNSS_qcom_cfg.ini_symlink",
    vendor: true,
    installed_location: "firmware/wlan/qca_cld/adrastea/WCNSS_qcom_cfg.ini",
    symlink_target: "/vendor/etc/wifi/adrastea/WCNSS_qcom_cfg.ini",
}

cc_library_shared {
    name: "libqti_c2_store_abi_check",
    vendor: true,
    compile_multilib: "64",
    defaults: ["libcodec2-hidl-defaults@1.0"],
    shared_libs: ["libcodec2_hidl@1.2"],
    srcs: [
        "c2_store_abi_check/abi_check_1_0.cpp",
        "c2_store_abi_check/abi_check_1_2.cpp",
    ],
}

uwu_kernel {
    name: "kernel",
    kernel_dir: "kernel/xiaomi/sm7435",
    kernel_arch: "arm64",
    image_name: "Image",
    clang_version: "clang-r563880c",
    additional_flags: [
        "TARGET_PRODUCT=garnet",
    ],

    config: {
        defconfig: "gki_defconfig",
        fragments: [
            "vendor/parrot_GKI.config",
            "vendor/garnet_GKI.config",
            "vendor/debugfs.config",
        ],
    },

    dtb: {
        enabled: true,
        qcom_merge: true,
        target: "dtbs",
        image_name: "dtb.img",
    },

    dtbo: {
        enabled: true,
        target: "dtbs",
        image_name: "dtbo.img",
        page_size: 4096,
    },

    modules: {
        enabled: true,
        external_module_root: "kernel/xiaomi/sm7435-modules",
        external_modules: [
            "qcom/opensource/mmrm-driver",
            "qcom/opensource/audio-kernel",
            "qcom/opensource/camera-kernel",
            "qcom/opensource/cvp-kernel",
            "qcom/opensource/dataipa/drivers/platform/msm",
            "qcom/opensource/datarmnet/core",
            "qcom/opensource/datarmnet-ext/aps",
            "qcom/opensource/datarmnet-ext/offload",
            "qcom/opensource/datarmnet-ext/shs",
            "qcom/opensource/datarmnet-ext/perf",
            "qcom/opensource/datarmnet-ext/perf_tether",
            "qcom/opensource/datarmnet-ext/sch",
            "qcom/opensource/datarmnet-ext/wlan",
            "qcom/opensource/display-drivers/msm",
            "qcom/opensource/eva-kernel",
            "qcom/opensource/video-driver",
            "qcom/opensource/wlan/qcacld-3.0/.adrastea",
        ],
        vendor_dlkm_module_install_list: [
            "device/xiaomi/garnet/modules/modules.list.second_stage",
            "device/xiaomi/garnet/modules/modules.list.vendor_dlkm",
        ],
        vendor_dlkm_module_load_list: [
            "device/xiaomi/garnet/modules/modules.list.second_stage",
            "device/xiaomi/garnet/modules/modules.list.vendor_dlkm",
        ],
        vendor_dlkm_install_all: true,
        vendor_ramdisk_module_install_list: [
            "kernel/xiaomi/sm7435/modules.list.msm.parrot",
            "device/xiaomi/garnet/modules/modules.list.first_stage",
            "device/xiaomi/garnet/modules/modules.list.second_stage",
        ],
        vendor_ramdisk_module_load_list: [
            "kernel/xiaomi/sm7435/modules.list.msm.parrot",
            "device/xiaomi/garnet/modules/modules.list.first_stage",
        ],
        recovery_module_install_list: [
            "kernel/xiaomi/sm7435/modules.list.msm.parrot",
            "device/xiaomi/garnet/modules/modules.list.first_stage",
            "device/xiaomi/garnet/modules/modules.list.second_stage",
        ],
        recovery_module_load_list: [
            "kernel/xiaomi/sm7435/modules.list.msm.parrot",
            "device/xiaomi/garnet/modules/modules.list.first_stage",
            "device/xiaomi/garnet/modules/modules.list.second_stage",
        ],
        vendor_dlkm_module_blocklist: "kernel/xiaomi/sm7435/modules.vendor_blocklist.msm.parrot",
        vendor_ramdisk_module_blocklist: "kernel/xiaomi/sm7435/modules.vendor_blocklist.msm.parrot",
        recovery_module_blocklist: "kernel/xiaomi/sm7435/modules.vendor_blocklist.msm.parrot",
    },
}
