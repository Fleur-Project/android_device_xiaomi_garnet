soong_namespace {
    imports: [
        "hardware/google/interfaces",
        "hardware/google/pixel/pixelstats",
        "hardware/google/pixel/power-libperfmgr",
        "hardware/lineage/interfaces/power-libperfmgr",
        "hardware/qcom-caf/common/libqti-perfd-client",
        "hardware/xiaomi",
        "vendor/qcom/opensource/commonsys-intf/display",
    ],
}

install_symlink {
    name: "firmware_wlan_mac.bin_symlink",
    vendor: true,
    installed_location: "firmware/wlan/qca_cld/adrastea/wlan_mac.bin",
    symlink_target: "/mnt/vendor/persist/wlan/wlan_mac.bin",
}

install_symlink {
    name: "firmware_WCNSS_qcom_cfg.ini_symlink",
    vendor: true,
    installed_location: "firmware/wlan/qca_cld/adrastea/WCNSS_qcom_cfg.ini",
    symlink_target: "/vendor/etc/wifi/adrastea/WCNSS_qcom_cfg.ini",
}

cc_library_shared {
    name: "libqti_c2_store_abi_check",
    vendor: true,
    compile_multilib: "64",
    defaults: ["libcodec2-hidl-defaults@1.0"],
    shared_libs: ["libcodec2_hidl@1.2"],
    srcs: [
        "c2_store_abi_check/abi_check_1_0.cpp",
        "c2_store_abi_check/abi_check_1_2.cpp",
    ],
}
